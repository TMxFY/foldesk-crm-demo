[Unit]
Description=Foldesk Telegram CRM — Scheduled Leadgen & Strict ICP Replenishment
After=network-online.target crmtg.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/crmtg
EnvironmentFile=-/opt/crmtg/.env
Environment="HOME=/root"
Environment="PATH=/opt/crmtg/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONUNBUFFERED=1"
Environment="CRMTG_VPS_RUNTIME=1"
ExecStart=/opt/crmtg/.venv/bin/python -m leadgen.vps_autonomous_replenish --db /opt/crmtg/data/crm.db
TimeoutStartSec=600
