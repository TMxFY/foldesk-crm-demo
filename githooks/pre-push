#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PYTHON_BIN="${PYTHON_BIN:-python3}"
if [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON_BIN="$ROOT/.venv/bin/python"
else
  COMMON_GIT_DIR="$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null || true)"
  if [ -n "$COMMON_GIT_DIR" ]; then
    MAIN_REPO_ROOT="$(cd "$ROOT" && cd "$COMMON_GIT_DIR/.." 2>/dev/null && pwd || true)"
    if [ -n "$MAIN_REPO_ROOT" ] && [ -x "$MAIN_REPO_ROOT/.venv/bin/python" ]; then
      PYTHON_BIN="$MAIN_REPO_ROOT/.venv/bin/python"
    fi
  fi
fi

bash "$ROOT/scripts/verify.sh"
PYTHONPATH="$ROOT" "$PYTHON_BIN" "$ROOT/scripts/proactive_audit.py" --self-test
